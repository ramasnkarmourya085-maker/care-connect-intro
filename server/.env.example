PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/careconnect

# Allow your frontend origin (comma separated). Use * for testing.
CORS_ORIGIN=*

# Cloudinary credentials (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase project ref + JWKS used to verify Google sign-in tokens
# Get from: src/integrations/supabase/client.ts -> SUPABASE_URL
SUPABASE_URL=https://txjqjismdlmfgsmwyipt.supabase.co
